# ============================================================
# MorphoCheck Pro — Root .env (Docker Compose uchun)
# Faylni nusxalab: cp .env.example .env
# ============================================================

# PostgreSQL
POSTGRES_USER=morpho
POSTGRES_PASSWORD=morpho_secret_2024
POSTGRES_DB=morphocheck
POSTGRES_PORT=5432

# Backend security
# Yaratish: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_at_least_32_random_characters_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend runtime
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
UVICORN_WORKERS=4
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Superadmin
MORPHOCHECK_SUPERADMIN_EMAIL=ortiqovshoxrux1996@gmail.com
MORPHOCHECK_SUPERADMIN_PASSWORD=
MORPHOCHECK_SUPERADMIN_NAME=Super Admin

# SMTP
LOGIN_VERIFICATION_TTL_MINUTES=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# AI
GEMINI_API_KEY=your_gemini_api_key_here

# Redis
CACHE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
CACHE_TTL_SECONDS=900
CACHE_MEMORY_MAX_ITEMS=512

# MinIO (PDF va rasm saqlash)
MINIO_ACCESS_KEY=morpho_minio
MINIO_SECRET_KEY=morpho_minio_secret_2024
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# DB Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30
