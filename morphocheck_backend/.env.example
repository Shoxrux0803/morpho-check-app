# Database configuration
DATABASE_URL=sqlite:///./morphocheck.db

# JWT Configuration
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_at_least_32_random_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

MORPHOCHECK_SUPERADMIN_EMAIL=ortiqovshoxrux1996@gmail.com
MORPHOCHECK_SUPERADMIN_PASSWORD=
MORPHOCHECK_SUPERADMIN_NAME=Super Admin

LOGIN_VERIFICATION_TTL_MINUTES=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Security
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Cache / NLP acceleration
# Set CACHE_BACKEND=memory to disable Redis and use in-process TTL cache only.
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=900
CACHE_MEMORY_MAX_ITEMS=512
