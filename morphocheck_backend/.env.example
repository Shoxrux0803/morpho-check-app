# ============================================================
# MorphoCheck Pro — Environment Variables
# Faylni nusxalab: cp .env.example .env
# So'ng haqiqiy qiymatlarni kiriting
# ============================================================

# ------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------
# LOCAL DEV (Docker):
DATABASE_URL=postgresql+psycopg2://morpho:morpho_secret_2024@localhost:5432/morphocheck

# PRODUCTION (masalan, Render, Supabase, Railway):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# PostgreSQL sozlamalari (docker-compose uchun)
POSTGRES_USER=morpho
POSTGRES_PASSWORD=morpho_secret_2024
POSTGRES_DB=morphocheck
POSTGRES_PORT=5432

# Ulanish havzasi (Pool)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30
DB_INIT_RETRIES=30
DB_INIT_DELAY=2

# ------------------------------------------------------------
# JWT / Xavfsizlik
# ------------------------------------------------------------
# Yaratish: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_at_least_32_random_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------
# Superadmin
# ------------------------------------------------------------
# Bu o'zgaruvchi muhim! Superadmin qurilma tasdiqlashida ishlatiladi.
# Haqiqiy emailingizni faqat .env faylida yozing, bu yerda emas!
MORPHOCHECK_SUPERADMIN_EMAIL=your_superadmin_email@example.com
MORPHOCHECK_SUPERADMIN_PASSWORD=your_strong_password_here
MORPHOCHECK_SUPERADMIN_NAME=Super Admin

# ------------------------------------------------------------
# Email / SMTP
# ------------------------------------------------------------
LOGIN_VERIFICATION_TTL_MINUTES=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ------------------------------------------------------------
# CORS va Xost sozlamalari
# ------------------------------------------------------------
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ------------------------------------------------------------
# AI / Gemini
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# Redis (Cache)
# ------------------------------------------------------------
# CACHE_BACKEND=memory  <-- Redis o'rniga xotirada saqlash uchun
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CACHE_TTL_SECONDS=900
CACHE_MEMORY_MAX_ITEMS=1024

# ------------------------------------------------------------
# MinIO (PDF va rasm saqlash — S3 compatible)
# ------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=morpho_minio
MINIO_SECRET_KEY=morpho_minio_secret_2024
MINIO_BUCKET_PDF=morphocheck-pdfs
MINIO_BUCKET_IMAGES=morphocheck-images
MINIO_SECURE=false
# MinIO Dashboard: http://localhost:9001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------
# Server sozlamalari
# ------------------------------------------------------------
# Workers: CPU * 2 + 1 (masalan, 4 yadroli = 9)
# PostgreSQL bilan ko'p worker ishlatish xavfsiz
UVICORN_WORKERS=4
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# SQLAlchemy debug (faqat dev uchun)
SQLALCHEMY_ECHO=false

# ------------------------------------------------------------
# Monitoring (Sentry)
# ------------------------------------------------------------
SENTRY_DSN=your_sentry_dsn_here

# ------------------------------------------------------------
# 2-BOSQICH: TimescaleDB (keyingi)
# ------------------------------------------------------------
# TIMESCALE_URL=postgresql+psycopg2://morpho:PASSWORD@localhost:5433/morphocheck_ts

# ------------------------------------------------------------
# 3-BOSQICH: ClickHouse (keyingi)
# ------------------------------------------------------------
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_DB=morphocheck_analytics

# ------------------------------------------------------------
# 3-BOSQICH: pgvector / AI embedding (keyingi)
# ------------------------------------------------------------
# VECTOR_DB_URL=postgresql+psycopg2://morpho:PASSWORD@localhost:5432/morphocheck
# OPENAI_API_KEY=your_openai_key_for_embeddings
